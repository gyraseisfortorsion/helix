# Copy to .env. All credentials stay on the backend.
DNA_DATA_DIR=./data
DNA_ACCESS_KEY=
DNA_ALLOW_LOCAL_WORKSPACES=true
DNA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANTHROPIC_API_KEY=
DNA_LLM_MODEL=anthropic:claude-sonnet-5-5
ALPHAGENOME_API_KEY=
# Hosted option: https://health.api.nvidia.com/v1/biology/arc/evo2-7b/forward
# Set EVO2_ACCESS_TOKEN to the NVIDIA API key for hosted requests.
EVO2_FORWARD_URL=
# Self-hosted option: service origin, e.g. http://127.0.0.1:8002
EVO2_BASE_URL=
EVO2_ACCESS_TOKEN=
# Required only on the GPU host, never in the frontend.
NGC_API_KEY=
LOCAL_NIM_CACHE=
# Optional indexed reference FASTAs for validation/indel normalization.
DNA_REFERENCE_GRCH37=
DNA_REFERENCE_GRCH38=
