# Leave empty for the local Vite proxy or the configured Vercel /api rewrite.
# The current Vercel rewrite forwards /api to the deployed VPS at 34.31.166.71.
# For a direct HTTPS backend connection, set this in Production and redeploy.
# Use the HTTPS backend origin, e.g. https://api.yourdomain.com (no /api suffix).
# This URL is public. Provider API keys must only be configured on the backend.
VITE_API_BASE_URL=
