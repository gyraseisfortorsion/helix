# Copy this file to the repository root as .env ON THE VPS, then edit it.
# Keep .env out of Git. These values belong to the backend container.
COMPOSE_PROJECT_NAME=strand

# Backend DNS hostname only, without https:// or a path.
# Point its A record to your VPS and allow inbound TCP ports 80 and 443.
API_DOMAIN=api.yourdomain.com

# These are the FRONTEND origins, with no trailing slash.
DNA_CORS_ORIGINS=https://helix-lime-nine.vercel.app,https://helix-gyraseisfortorsions-projects.vercel.app

# Public demo profiles work without this. Set a random value to enable private uploads.
DNA_ACCESS_KEY=
DNA_ALLOW_LOCAL_WORKSPACES=false
DNA_DATA_DIR=/data
DNA_EMBEDDED_WORKER=true

# Paste your existing credentials here on the VPS.
ANTHROPIC_API_KEY=
DNA_LLM_MODEL=anthropic:claude-sonnet-5-5
ALPHAGENOME_API_KEY=
EVO2_FORWARD_URL=https://health.api.nvidia.com/v1/biology/arc/evo2-7b/forward
EVO2_ACCESS_TOKEN=

# Optional: expose the API on a different LOOPBACK port for local checks.
API_PORT=8000
